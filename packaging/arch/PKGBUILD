# Maintainer: Cosmo <cptncosmo@gmail.com>
# Builds from the surrounding git checkout (used by CI); no source download.

pkgname=token-converter
pkgver=0.1.0
pkgrel=1
pkgdesc='Recursively batch-convert media files in project folders (Qt 6 / KDE Kirigami)'
arch=('x86_64')
url='https://github.com/cptn-cosmo/token-converter'
license=('GPL-3.0-or-later')
depends=(
  'glibc'
  'hicolor-icon-theme'
  'kconfig'
  'kcoreaddons'
  'ki18n'
  'kirigami'
  'libstdc++'
  'libwebp'
  'qqc2-desktop-style'
  'qt6-base'
  'qt6-declarative'
)
makedepends=('cmake' 'extra-cmake-modules' 'git' 'ninja')
options=('!debug')
source=()
sha256sums=()

_srcroot="$(realpath "${startdir}/../..")"

pkgver() {
  cd "${_srcroot}"
  local tag base
  # Release: HEAD is exactly a version tag -> plain version (v0.2.0 -> 0.2.0)
  if tag=$(git describe --tags --exact-match --match 'v[0-9]*' HEAD 2>/dev/null); then
    printf '%s' "${tag#v}"
    return
  fi
  # Prerelease: <last tag or CMake version>.r<commits since>.g<hash>
  if tag=$(git describe --tags --abbrev=0 --match 'v[0-9]*' HEAD 2>/dev/null); then
    printf '%s.r%s.g%s' "${tag#v}" "$(git rev-list --count "${tag}..HEAD")" "$(git rev-parse --short=7 HEAD)"
  else
    base=$(sed -nE 's/^project\(token-converter VERSION ([0-9.]+).*/\1/p' CMakeLists.txt)
    printf '%s.r%s.g%s' "${base}" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

build() {
  cmake -B build -S "${_srcroot}" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
